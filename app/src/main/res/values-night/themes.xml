        <item name="colorIconOnCard">#FFD1FA</item>
        <item name="actionBarStyle">@style/Widget.Sobriety.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Sobriety.ActionBar</item>
